# Copy to .env on the server and fill in every value marked CHANGE.
APP_NAME="REFRA"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# CHANGE: the real address, with https and no trailing slash
APP_URL=https://www.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning

# CHANGE: from your host's database panel
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# CHANGE: without real SMTP, order emails and password resets are never delivered
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="orders@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# CHANGE: first admin login. The password needs 12+ characters and is only read on first seed.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_IDLE_MINUTES=30

# Optional: Claude-powered Fit Advisor (falls back to rule-based matching when empty)
ANTHROPIC_API_KEY=
FIT_ADVISOR_MODEL=claude-opus-5-5
FIT_ADVISOR_TIMEOUT=20

GALLERY_LAYOUT=grid
MEDIA_URL=

# Only behind Cloudflare or a load balancer: * or comma-separated proxy IPs
TRUSTED_PROXIES=
